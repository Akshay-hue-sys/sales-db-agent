# ==============================================================================
# Environment Configuration Template for Sales DB Agent
# Copy this file to .env and populate your personal secrets:
#   cp .env.example .env
# ==============================================================================

# Database Connection URL (PostgreSQL 16 with pgvector extension)
DATABASE_URL=postgresql://user:password@localhost:5432/sales_db

# Google Gemini API Key (Required for dynamic model discovery and ReAct reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
